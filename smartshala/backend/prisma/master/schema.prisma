generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@smartshala/master-client"
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

model School {
  id                    String                 @id @default(uuid()) @db.Uuid
  schoolId              String                 @unique @db.VarChar(8)
  schoolName            String
  ownerName             String
  email                 String
  phone                 String
  address               String
  numberOfStudents      Int
  numberOfStaff         Int
  planType              PlanType
  paymentStatus         PaymentStatus          @default(PENDING)
  amountPaid            Decimal                @default(0) @db.Decimal(12, 2)
  couponCode            String?
  isTrial               Boolean                @default(false)
  trialEndsAt           DateTime?
  isActive              Boolean                @default(true)
  deletionStatus        TenantDeletionStatus   @default(NONE)
  deletionRequestedAt   DateTime?
  deletionScheduledAt   DateTime?
  deletionCancelledAt   DateTime?
  deletionExecutedAt    DateTime?
  deletionRequestedBy   String?
  dbName                String                 @unique
  dbUrl                 String
  directDbUrl           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  passwordResetRequests PasswordResetRequest[]
  subscription          Subscription?
  invoices              Invoice[]
  billingNotifications  BillingNotification[]

  @@index([schoolId, isActive])
  @@index([deletionStatus, deletionScheduledAt])
  @@index([email])
  @@map("schools")
}

model PasswordResetRequest {
  id          String              @id @default(uuid()) @db.Uuid
  schoolId    String              @db.VarChar(8)
  userId      String              @db.Uuid
  userName    String
  email       String?
  phone       String
  role        String
  identifier  String
  status      PasswordResetStatus @default(PENDING)
  requestedAt DateTime            @default(now())
  completedAt DateTime?
  completedBy String?
  school      School              @relation(fields: [schoolId], references: [schoolId], onDelete: Cascade)

  @@index([status, requestedAt])
  @@index([schoolId, status])
  @@map("password_reset_requests")
}

model Coupon {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @unique
  description    String?
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(12, 2)
  maxRedemptions Int?
  redeemedCount  Int          @default(0)
  isActive       Boolean      @default(true)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@index([code, isActive])
  @@map("coupons")
}

model OnboardingLog {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.VarChar(8)
  status    String
  message   String
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@map("onboarding_logs")
}

enum PlanType {
  TRIAL
  STANDARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  TRIAL
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TenantDeletionStatus {
  NONE
  PENDING
  CANCELLED
  DELETED
  FAILED
}

enum PasswordResetStatus {
  PENDING
  COMPLETED
  DISMISSED
}

// ---------------------------------------------------------------------------
// Billing: plan catalogue, per-school subscription, invoices and payments.
// Money is stored in minor units (paise) because that is what Razorpay speaks.
// ---------------------------------------------------------------------------

model Plan {
  id            String          @id @default(uuid()) @db.Uuid
  code          String          @unique
  name          String
  description   String?
  priceMinor    Int
  currency      String          @default("INR")
  interval      BillingInterval @default(YEAR)
  intervalCount Int             @default(1)
  trialDays     Int             @default(0)
  maxStudents   Int?
  maxStaff      Int?
  features      Json            @default("{}")
  isActive      Boolean         @default(true)
  isPublic      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([isActive, sortOrder])
  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  schoolId           String             @unique @db.VarChar(8)
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  gracePeriodEndsAt  DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  couponCode         String?
  // Negotiated rate for this one school. Null means "charge the plan's list
  // price", which is the default for everybody. Set it and every invoice and
  // renewal for this school bills at this amount instead.
  customPriceMinor   Int?
  customPriceNote    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt

  school   School    @relation(fields: [schoolId], references: [schoolId], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  number          String        @unique
  schoolId        String        @db.VarChar(8)
  subscriptionId  String?       @db.Uuid
  planId          String?       @db.Uuid
  planCode        String
  planName        String
  status          InvoiceStatus @default(DUE)
  currency        String        @default("INR")
  subtotalMinor   Int
  discountMinor   Int           @default(0)
  taxMinor        Int           @default(0)
  totalMinor      Int
  amountPaidMinor Int           @default(0)
  couponCode      String?
  periodStart     DateTime
  periodEnd       DateTime
  issuedAt        DateTime      @default(now())
  dueAt           DateTime
  paidAt          DateTime?
  voidedAt        DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  school       School        @relation(fields: [schoolId], references: [schoolId], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan         Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([schoolId, issuedAt])
  @@index([status, dueAt])
  @@map("invoices")
}

model Payment {
  id                String       @id @default(uuid()) @db.Uuid
  invoiceId         String       @db.Uuid
  schoolId          String       @db.VarChar(8)
  provider          String       @default("razorpay")
  gatewayMode       GatewayMode  @default(MOCK)
  providerOrderId   String?      @unique
  providerPaymentId String?      @unique
  providerSignature String?
  status            PaymentState @default(CREATED)
  amountMinor       Int
  currency          String       @default("INR")
  method            String?
  failureReason     String?
  refundedMinor     Int          @default(0)
  refundReference   String?
  capturedAt        DateTime?
  notes             Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([status])
  @@map("payments")
}

model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String    @default("razorpay")
  eventId        String
  eventType      String
  payload        Json
  signatureValid Boolean   @default(false)
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([eventType, createdAt])
  @@map("webhook_events")
}

model BillingEvent {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String?  @db.VarChar(8)
  actor     String
  action    String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([action, createdAt])
  @@map("billing_events")
}

// Every billing message the school was sent, and every one that failed to go
// out. When a principal says "nobody told us", this is the answer.
model BillingNotification {
  id        String                    @id @default(uuid()) @db.Uuid
  schoolId  String                    @db.VarChar(8)
  type      BillingNotificationType
  recipient String
  message   String
  status    BillingNotificationStatus @default(SENT)
  error     String?
  // One row per school + type + subject (an invoice id, a period end), so the
  // hourly maintenance sweep cannot send the same warning again every hour.
  dedupeKey String
  sentAt    DateTime?
  createdAt DateTime                  @default(now())

  school School @relation(fields: [schoolId], references: [schoolId], onDelete: Cascade)

  @@unique([schoolId, type, dedupeKey])
  @@index([schoolId, createdAt])
  @@map("billing_notifications")
}

enum BillingInterval {
  MONTH
  YEAR
}

enum BillingNotificationType {
  INVOICE_RAISED
  RENEWAL_UPCOMING
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PAST_DUE
  GRACE_ENDING
  SUSPENDED
}

enum BillingNotificationStatus {
  SENT
  FAILED
  SKIPPED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  DUE
  PAID
  VOID
  REFUNDED
}

enum PaymentState {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum GatewayMode {
  MOCK
  LIVE
}
