<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The night qualifier outranks the version one, so values-night would
         otherwise answer for a phone on Android 12+ in dark mode and leave the
         splash colour unset. The app itself is light-only. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_launch_background</item>
        <!-- Keep OEM dark modes (e.g. ColorOS) from recolouring the light-only Flutter UI. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
