// The Release build of the Teacher app. Same two lines the Flutter template
// puts in Release.xcconfig, plus the flavor's identity. CocoaPods names the file
// it generates after the build configuration, lowercased, hence the suffix.
#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release-teacher.xcconfig"
#include "Generated.xcconfig"
#include "teacher.xcconfig"

// APNs issues a different device token per environment, and a token from
// one is rejected by the other.
APS_ENVIRONMENT = production
